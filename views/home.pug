doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Deadline Bot 3000 | Home
    link(rel="stylesheet", href="/styles/style.css")
    script(src="/scripts/client.js")

  body
    if alertMessage 
      script.
        alert("#{alertMessage}")

    header
      h1 Deadline Bot 3000
      p Simplifying your Carleton semester

    ul.navbar
      li: a(href="/") Dashboard
      if session.loggedIn
        li: a(href="/logout") Logout
        li: a(href="/addcourse") Add Course
      else
        li: a(href="/login") Login
        li: a(href="/register") Register

    .container
      section.course-card
        h2 Welcome to your Dashboard
        p This application parses your PDF course outlines into a unified schedule. Get weekly updates on assignments, tests, and tutorials all in one place.

      if session.loggedIn
        section.course-card
          h3 Welcome back, #{session.user.firstname}!
          .dashboard-actions
            a.btn-primary-link(href="/addcourse") + Add Course


          h3 Your Courses
          if courses && courses.length > 0
            ul.course-status-list#course-status-list
              each course in courses
                li.course-status-item(data-course-id=`${course._id}`)
                  .course-meta
                    strong #{course.course_code}
                    span.course-name  - #{course.course_name || 'Course'}
                  .course-row-actions
                    .course-status-action
                      if !course.summaryStatus || course.summaryStatus === 'completed'
                        a.btn-secondary(href=`/data?courseId=${course._id}`) Show Summary
                      else if course.summaryStatus === 'failed'
                        form(action='/courses/retry-summary', method='post')
                          input(type='hidden', name='courseId', value=`${course._id}`)
                          button.btn-secondary(type='submit') Retry Summary
                      else
                        .status-loading
                          span.loader
                          span Processing summary...
                    form(action='/courses/remove', method='post')
                      input(type='hidden', name='courseId', value=`${course._id}`)
                      input(type='hidden', name='redirectTo', value='/')
                      button.btn-danger(type='submit') Remove
          else
            p No courses yet. Click Add Course to get started.

          
          
          
          
      
        form(action="/subscribe", method="post")
          button.btn-primary(type="submit") Get Weekly Updates


      else 
        section.course-card
          h2 Get Started
          p Please #[a(href="/login") Log In] or #[a(href="/register") Create an Account] to start tracking your deadlines.

    if session.loggedIn
      script.
        window.addEventListener('DOMContentLoaded', function () {
          if (typeof startCourseStatusPolling === 'function') {
            startCourseStatusPolling();
          }
        });